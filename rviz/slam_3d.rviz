Panels:
  - Class: "rviz_common/Displays"
    Name: "Displays"
    Property Tree Widget:
      Expanded:
        - "/Global Options1"
      Splitter Ratio: 0.55
    Tree Height: 700
  - Class: "rviz_common/Views"
    Name: "Views"
    Expanded:
      - "/Current View1"
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: "root"
  Displays:
    - Class: "rviz_default_plugins/Grid"
      Name: "Grid"
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: "160; 160; 164"
      Alpha: 0.3
    - Class: "rviz_default_plugins/PointCloud2"
      Name: "Mapa GLIM (acumulado)"
      Enabled: true
      Value: true
      Topic:
        Value: "/glim_ros/aligned_points"
        Depth: 5
        Durability Policy: "Volatile"
        History Policy: "Keep Last"
        Reliability Policy: "Best Effort"
      Style: "Points"
      Size (m): 0.04
      Size (Pixels): 2
      Color Transformer: "AxisColor"
      Axis: "Z"
      Color: "200; 200; 200"
      Decay Time: 600
      Alpha: 1
      Position Transformer: "XYZ"
      Autocompute Intensity Bounds: true
      Use Fixed Frame: true
    - Class: "rviz_default_plugins/PointCloud2"
      Name: "Scan actual"
      Enabled: true
      Value: true
      Topic:
        Value: "/glim_ros/points"
        Depth: 5
        Durability Policy: "Volatile"
        History Policy: "Keep Last"
        Reliability Policy: "Best Effort"
      Style: "Points"
      Size (m): 0.05
      Size (Pixels): 2
      Color Transformer: "FlatColor"
      Axis: "Z"
      Color: "255; 255; 0"
      Decay Time: 0
      Alpha: 1
      Position Transformer: "XYZ"
      Autocompute Intensity Bounds: true
      Use Fixed Frame: true
    - Class: "rviz_default_plugins/Odometry"
      Name: "Trayectoria GLIM"
      Enabled: true
      Value: true
      Topic:
        Value: "/glim_ros/odom"
        Depth: 5
        Durability Policy: "Volatile"
        History Policy: "Keep Last"
        Reliability Policy: "Best Effort"
      Keep: 2000
      Position Tolerance: 0.2
      Angle Tolerance: 0.2
      Shape:
        Alpha: 1
        Color: "255; 200; 0"
        Head Length: 0.15
        Head Radius: 0.06
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Value: "Arrow"
      Covariance:
        Value: false
    - Class: "rviz_default_plugins/TF"
      Name: "TF"
      Enabled: true
      Value: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.6
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: "40; 42; 48"
    Fixed Frame: "map"
    Frame Rate: 30
  Tools:
    - Class: "rviz_default_plugins/MoveCamera"
    - Class: "rviz_default_plugins/Select"
    - Class: "rviz_default_plugins/FocusCamera"
    - Class: "rviz_default_plugins/Measure"
      Line color: "128; 128; 0"
  Transformation:
    Current:
      Class: "rviz_default_plugins/TF"
  Value: true
  Views:
    Current:
      Class: "rviz_default_plugins/Orbit"
      Name: "Current View"
      Distance: 30.0
      Pitch: 0.9
      Yaw: 3.3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: "<Fixed Frame>"
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 60
  Y: 40
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
